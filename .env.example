# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase.
# Os dois valores são públicos por natureza (a segurança vem das regras RLS do banco).
# NUNCA coloque aqui a senha do banco nem a chave "service_role"/secreta.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Endereço público (https://...) da Política de Privacidade, exibido no Perfil.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
